{
    // Exclude internal Ionic entry points from auto-import suggestions (ionic-team/starters#1873)
    "js/ts.preferences.autoImportFileExcludePatterns": [
        "@ionic/angular/types/ionic-angular-lazy.d.ts",
        "@ionic/angular/types/ionic-angular-common.d.ts"
    ],

    // Use workspace TypeScript compiler
    "js/ts.tsdk.path": "node_modules/typescript/lib",
    "js/ts.preferences.includePackageJsonAutoImports": "auto",

    // Default code formatting
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.rulers": [120],

    // ESLint auto-fix on save and validations
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit"
    },
    "eslint.validate": ["typescript", "html"],
    "eslint.workingDirectories": [{ "mode": "auto" }],

    // Disable built-in HTML formatting so Prettier handles Angular templates
    "html.format.enable": false,

    // Language-specific formatter settings
    "[typescript][javascript][html][scss][json][jsonc]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },

    // File exclusions for search and watcher performance in Ionic/Angular
    "files.exclude": {
        "**/.git": true,
        "**/.DS_Store": true,
        "**/.angular/cache": true,
        "**/www": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/www": true,
        "**/.angular": true
    },

    //Disable Biome extension recommendation since it is not compatible with Prettier and ESLint
    "biome.enabled": false,
    "[svg]": {
        "editor.defaultFormatter": "jock.svg"
    },
    "java.configuration.updateBuildConfiguration": "interactive"
}
